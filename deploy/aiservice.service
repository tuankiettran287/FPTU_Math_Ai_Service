# Mẫu systemd cho AI service trên VPS.
# Copy thành /etc/systemd/system/aiservice.service, sửa đường dẫn, rồi:
#   sudo systemctl daemon-reload && sudo systemctl enable --now aiservice
#   journalctl -u aiservice -f
[Unit]
Description=FPTU Math AI Service (FastAPI)
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/FPTU_Math_Ai_Service-main
EnvironmentFile=/opt/FPTU_Math_Ai_Service-main/.env
ExecStart=/opt/FPTU_Math_Ai_Service-main/.venv/bin/uvicorn AI_service.main:app --host 0.0.0.0 --port 8080 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
